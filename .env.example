# MCP Server Transport Configuration
# Use "stdio" for MCP clients like Claude Desktop (default)
# Use "http" for development/testing
MT5_MCP_TRANSPORT=stdio

# HTTP Transport Settings (only used when MT5_MCP_TRANSPORT=http)
MT5_MCP_HOST=127.0.0.1
MT5_MCP_PORT=8000

# MetaTrader 5 Configuration (optional, can be passed to tools or loaded from .env)
# Note: Paths with spaces and backslashes must be quoted
MT5_PATH="C:\Program Files\MetaTrader 5\terminal64.exe"
MT5_LOGIN=123456
MT5_PASSWORD="your_password"
MT5_SERVER="YourBroker-Demo"

# -----------------------------------------------------------------------------
# Hosted backend (optional) - TickerAll MT5 API (https://tickerall.com)
# -----------------------------------------------------------------------------
# Set TICKERALL_API_KEY to run the SAME MCP tools on any OS (Linux/macOS/Windows,
# or in a container) with NO local MetaTrader 5 terminal. When it is unset, the
# server uses the local MetaTrader5 terminal exactly as before (nothing changes).
#   pip install mcp-metatrader5-server[tickerall]
#
# TICKERALL_API_KEY="cf_api_your_key_here"
#
# The API key is all you need: connect your broker account through the server by
# calling the login(account, password, server) tool - it connects and warms the
# account for you, and the account is resolved from your key automatically.
#
# Optional: if your key has several connected accounts, set this to auto-select
# one instead of calling the use_account() tool each session.
# TICKERALL_ACCOUNT_ID="your_account_id"
#
# Accounts you log in with are remembered locally so they reconnect
# automatically next session without re-entering the password. The store is
# client-side only (TickerAll never persists credentials), encrypted at rest
# with a key bound to this machine (and 0600 file permissions on Unix). Set to 0
# to disable (you'll then log in each session).
# TICKERALL_REMEMBER_ACCOUNTS=1
